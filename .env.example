# ============ OneHub 环境变量模板 ============
# 使用：复制为 .env 后按需修改。真实密钥永不入 git（禁改清单红线）。
# compose 会将 .env 注入 api 容器，键名与 backend/app/core/config.py 一一对应。

# W1 验收脚本（scripts/acceptance/verify.mjs）读取的固定网关 Key——W2 起网关面
# 鉴权已迁到 api_keys 表（哈希校验），本键仅供历史验收脚本使用，业务不再读取
# GATEWAY_API_KEY=sk-gateway-dev

# DeepSeek 渠道密钥（必填：替换为你在 DeepSeek 开放平台申请的真实 Key）
DEEPSEEK_API_KEY=

# PostgreSQL 连接串（容器内走 compose 内网地址 pg；本地直连请改 localhost）
DATABASE_URL=postgresql+asyncpg://onehub:onehub@pg:5432/onehub

# Redis 连接串（同上，容器内地址为 redis）
REDIS_URL=redis://redis:6379/0

# 管理面 JWT 签名密钥（W2 启用；请替换为 ≥32 字节随机串，如 openssl rand -hex 32，勿用示例值）
SECRET_KEY=change-me